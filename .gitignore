# Build output
bin/
obj/

# Python
voice_server/venv/
voice_server/venv_path.txt
# Which GTA V install to deploy into - chosen per machine (cft where)
voice_server/gta_path.txt
__pycache__/
*.pyc

# Models are large binaries - fetched per machine, never committed.
# Leading ** so a character folder (models/rvc/Michael/x.pth) is covered too:
# a plain models/rvc/*.pth does not match across a directory separator.
voice_server/models/**/*.onnx
voice_server/models/**/*.onnx.json
voice_server/models/**/*.pth
voice_server/models/**/*.index
voice_server/models/**/*.zip
# The layout itself is committed, so a fresh clone has somewhere to download to.
!voice_server/models/**/.gitkeep

# Installer log
voice_server/setup.log

# Test artifacts
voice_server/test_output.wav

# iFruit Jailbreak is a separate mod - its DLL is vendored per machine
lib/*.dll

# Twitch and DonationAlerts tokens, in plain text. The .example stays tracked.
voice_server/events.env
/src/CallFromTwitch/.vs
docs/gta4-research.md
