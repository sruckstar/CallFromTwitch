# =====================================================================
# CallFromTwitch - баллы канала и донаты
# =====================================================================
# Скопируйте этот файл в events.env (рядом, без .example) и заполните.
# run_server.bat подхватит его сам. Строки с # игнорируются.
#
# ВНИМАНИЕ: здесь лежат токены открытым текстом. Не показывайте этот файл
# на стриме и не выкладывайте его в общий доступ. events.env уже добавлен
# в .gitignore.
#
# Всё это нужно ТОЛЬКО для баллов канала и денежных донатов. Чат, сабы и
# биты мод читает сам, без единого токена, — им ничего настраивать не надо.

# Главный выключатель. 0 — сервер не открывает никаких сокетов к Twitch.
CFT_EVENTS=1


# ---------------------------------------------------------------------
# 1. БАЛЛЫ КАНАЛА (Twitch EventSub)
# ---------------------------------------------------------------------
# Ваш канал: только имя, без https://
CFT_TWITCH_CHANNEL=

# Client ID приложения. Где взять:
#   1) https://dev.twitch.tv/console/apps -> Register Your Application
#   2) Name — любое, OAuth Redirect URL — http://localhost:3000
#      Category — Application Integration
#   3) Скопируйте Client ID сюда.
CFT_TWITCH_CLIENT_ID=

# Токен САМОГО СТРИМЕРА со скоупом channel:read:redemptions.
# Токен бота НЕ подойдёт: читать награды своего канала может только его
# владелец. Быстрый способ получить — https://twitchtokengenerator.com,
# выбрать scope channel:read:redemptions, авторизоваться своим каналом.
# Токен живёт ~60 дней, потом его надо получить заново.
CFT_TWITCH_TOKEN=

# Название награды, за которую звонит телефон. Пусто — подходит ЛЮБАЯ
# награда, что почти наверняка не то, чего вы хотите: сюда попадут и
# "выделить сообщение", и все остальные. Впишите точное название своей
# награды, как оно видно зрителям.
# Награду создавать в Творческой панели -> Лояльность -> Награды за баллы,
# обязательно включив в ней "Требовать ввод текста от зрителя" — иначе
# зрителю нечего будет сказать, и звонок озвучит DefaultEventText из ini.
CFT_POINTS_REWARD=


# ---------------------------------------------------------------------
# 2. ДЕНЕЖНЫЕ ДОНАТЫ (DonationAlerts)
# ---------------------------------------------------------------------
# Twitch о таких донатах не знает: деньги принимает DonationAlerts, он же
# единственный, кто может о них рассказать.
# Токен: https://www.donationalerts.com/application/clients
#   создать приложение -> получить OAuth-токен со скоупом
#   oauth-donation-subscribe
# Оставьте пустым, если донаты не нужны.
CFT_DA_TOKEN=


# ---------------------------------------------------------------------
# 3. ТЕСТИРОВАНИЕ
# ---------------------------------------------------------------------
# Разрешает POST /events/test — поддельные донаты и баллы. Без этого
# проверить платные пути невозможно в принципе: себе не задонатишь и
# баллы себе не купишь. Запускается через test_events.bat.
# Сервер слушает только 127.0.0.1, так что снаружи сюда не достучаться;
# ставьте 0, только если совсем не хотите оставлять этот путь открытым.
CFT_EVENTS_TEST=1

# Сколько событий держать в очереди, пока игра их не заберёт.
CFT_EVENTS_QUEUE=50
